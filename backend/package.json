    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "@eslint/js": "^10.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.13.0",
    "supertest": "^7.0.0",
    "typescript-eslint": "^8.72.1",
