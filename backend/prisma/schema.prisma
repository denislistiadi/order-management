// Prisma Schema Definition for Order Management System
// Maps relational PostgreSQL database models and column constraints.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Customer gender enumeration
enum Gender {
  Pria
  Wanita
}

// System administrator and staff user accounts
model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[] @relation("CreatedByUser")

  @@map("users")
}

// Product catalog with inventory stock tracking and soft delete support
model Product {
  id          Int       @id @default(autoincrement())
  productCode String    @unique @map("product_code") @db.VarChar(20)
  productName String    @map("product_name") @db.VarChar(150)
  stock       Int       @default(0)
  price       Decimal   @db.Decimal(12, 2)
  deletedAt   DateTime? @map("deleted_at")

  orderItems OrderItem[]

  @@map("products")
}

// Customer profiles and billing/shipping addresses
model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  customerName    String    @map("customer_name") @db.VarChar(150)
  customerAddress String    @map("customer_address") @db.VarChar(255)
  gender          Gender
  birthDate       DateTime  @map("birth_date") @db.Date
  phone           String?   @db.VarChar(20)
  deletedAt       DateTime? @map("deleted_at")

  orders Order[]

  @@map("customers")
}

// Sales transactions and invoices generated by system operators
model Order {
  id          Int      @id @default(autoincrement())
  orderNumber String   @unique @map("order_number") @db.VarChar(30)
  customerId  String   @map("customer_id") @db.Uuid
  createdBy   String   @map("created_by") @db.Uuid
  orderDate   DateTime @default(now()) @map("order_date")
  totalAmount Decimal  @map("total_amount") @db.Decimal(14, 2)

  customer Customer    @relation(fields: [customerId], references: [id])
  user     User        @relation("CreatedByUser", fields: [createdBy], references: [id])
  items    OrderItem[]

  @@map("orders")
}

// Line items associated with an order, preserving historical unit price snapshots
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(14, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}
