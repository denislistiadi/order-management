# Root / Docker Compose Environment Reference
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=order_management
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/order_management?schema=public"

# Authentication (JWT & Refresh Token)
JWT_SECRET="super-secret-jwt-key-replace-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-replace-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend API Base URL
VITE_API_BASE_URL="http://localhost:3000/api"

